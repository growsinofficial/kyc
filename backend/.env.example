# Copy to backend/.env and fill in. Never commit backend/.env.

# --- Server ---
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
MONGODB_URI=mongodb://localhost:27017/kyc
JWT_SECRET=change-me
JWT_EXPIRE=7d
# TEST_MODE=true (and NODE_ENV not production): when Fast2SMS is not set up, the mobile
# code is shown on screen instead of being sent. Never on a real site.
TEST_MODE=false

# --- Mobile OTP (Fast2SMS: WhatsApp first, SMS fallback; same as the Growsin app) ---
# Sign-up verifies the mobile number only; email is required but not verified.
FAST2SMS_API_KEY=
# DLT-approved OTP template id (SMS route)
FAST2SMS_OTP_ID=
# WhatsApp Authentication template Message ID and the sending number's Phone Number ID
FAST2SMS_WA_MESSAGE_ID=
FAST2SMS_WA_PHONE_NUMBER_ID=
# Template variables, {otp} = the code, joined with | (e.g. {otp}|{otp})
FAST2SMS_WA_VARIABLES={otp}

# --- Email (OTP + notifications) ---
EMAIL_USERNAME=
EMAIL_FROM=
GMAIL_APP_PASSWORD=

# --- Agreement template ---
# The signed-off agreement PDF (24 pages, page 24 blank). It contains the adviser's
# signature, so it is NOT in git. Default location: backend/private/agreement-template.pdf
# AGREEMENT_TEMPLATE_PATH=/secure/path/agreement-template.pdf

# --- Digio Aadhaar eSign ---
# sandbox    -> https://ext.digio.in:444 (use sandbox client id/secret)
# production -> https://api.digio.in     (use production client id/secret)
# mock       -> no Digio calls; simulated OTP for local development (blocked when NODE_ENV=production)
DIGIO_MODE=sandbox
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
# Who signs in to the Digio window: email | mobile
DIGIO_SIGNER_IDENTIFIER=email
# Signing works like the Growsin app (growsin-console): the client is sent to Digio's hosted
# page and comes back to {FRONTEND_URL}/esign/complete, where the server re-checks with Digio.
# Optional host overrides (normally leave empty):
DIGIO_BASE_URL=
DIGIO_GATEWAY_URL=
# Webhook (optional): set https://<backend>/api/webhooks/digio in the Digio dashboard
# (Profile > Webhooks). Digio sends X-Digio-Checksum = hex HMAC-SHA256(raw body, this secret).
# The backend always re-checks the document with Digio before marking it signed.
DIGIO_WEBHOOK_SECRET=

# --- Zoho Payments / Books ---
ZOHO_PAYMENT_BASE_URL=
ZOHO_PAYMENT_API_KEY=
ZOHO_PAYMENT_SIGNING_KEY=
ZOHO_WEBHOOK_SECRET=
ZOHO_ORGANIZATION_ID=
ZOHO_BOOKS_ORGANIZATION_ID=
ZOHO_OAUTH_CLIENT_ID=
ZOHO_OAUTH_ACCESS_TOKEN=
ZOHO_OAUTH_REFRESH_TOKEN=
ZOHO_OAUTH_SCOPE=
