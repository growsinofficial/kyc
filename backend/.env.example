# Copy to backend/.env and fill in. Never commit backend/.env.

# --- Server ---
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
MONGODB_URI=mongodb://localhost:27017/kyc
JWT_SECRET=change-me
JWT_EXPIRE=7d
# TEST_MODE=true accepts the dummy OTPs 123456 (email) / 654321 (mobile). Never in production.
TEST_MODE=false

# --- Email (OTP + notifications) ---
EMAIL_USERNAME=
EMAIL_FROM=
GMAIL_APP_PASSWORD=

# --- Agreement template ---
# The signed-off agreement PDF (24 pages, page 24 blank). It contains the adviser's
# signature, so it is NOT in git. Default location: backend/private/agreement-template.pdf
# AGREEMENT_TEMPLATE_PATH=/secure/path/agreement-template.pdf

# --- Digio Aadhaar eSign ---
# sandbox    -> https://ext.digio.in:444 (use sandbox client id/secret)
# production -> https://api.digio.in     (use production client id/secret)
# mock       -> no Digio calls; simulated OTP for local development (blocked when NODE_ENV=production)
DIGIO_MODE=sandbox
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
# Who signs in to the Digio window: email | mobile
DIGIO_SIGNER_IDENTIFIER=email
# Logo shown in the Digio signing window (public https URL)
DIGIO_LOGO_URL=https://www.growsin.com/img/logo.png
# Webhook: set the URL https://<backend>/api/webhooks/digio in the Digio dashboard.
# Leave the secret empty until you have confirmed Digio's checksum header with Digio support;
# the backend always re-checks the document with Digio before marking it signed.
DIGIO_WEBHOOK_SECRET=

# --- Zoho Payments / Books ---
ZOHO_PAYMENT_BASE_URL=
ZOHO_PAYMENT_API_KEY=
ZOHO_PAYMENT_SIGNING_KEY=
ZOHO_WEBHOOK_SECRET=
ZOHO_ORGANIZATION_ID=
ZOHO_BOOKS_ORGANIZATION_ID=
ZOHO_OAUTH_CLIENT_ID=
ZOHO_OAUTH_ACCESS_TOKEN=
ZOHO_OAUTH_REFRESH_TOKEN=
ZOHO_OAUTH_SCOPE=
